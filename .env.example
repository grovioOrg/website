# Base URL of the Grovio core API. Beta registrations are POSTed to
# {NEXT_PUBLIC_API_CORE_BASE_URL}/api/v1/beta_registration
# Without it the beta form shows an error instead of pretending to succeed.
NEXT_PUBLIC_API_CORE_BASE_URL=

# Optional. Public URL of the site, used for canonical and hreflang links.
NEXT_PUBLIC_APP_URL=

# Optional. Adds a "Contact" link to the footer when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. URL of the privacy policy. Linked from the beta consent checkbox
# and the footer only when set, so leave it empty until the policy exists.
NEXT_PUBLIC_PRIVACY_URL=

# Optional. Shows the investors section and footer link, with a mailto to
# this address. Hidden when unset.
NEXT_PUBLIC_INVESTOR_EMAIL=
